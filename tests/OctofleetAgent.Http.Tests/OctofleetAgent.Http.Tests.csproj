<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Plain net8.0: the connection handling has no Windows dependencies, so this runs anywhere. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile only the connection handling: never start the service. -->
    <Compile Include="../../src/OctofleetAgent.Service/AgentHttp.cs" Link="AgentHttp.cs" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>
</Project>
