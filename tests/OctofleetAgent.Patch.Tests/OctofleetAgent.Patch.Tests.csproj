<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Plain net8.0: the result handling has no Windows dependencies, so this runs anywhere. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile only the result handling: no COM, no Windows Update calls. -->
    <Compile Include="../../src/OctofleetAgent.Service/PatchInstallResult.cs" Link="PatchInstallResult.cs" />
  </ItemGroup>
</Project>
