# OpenClaw Inventory Platform - Environment Variables

# ===================
# Backend Configuration
# ===================
DATABASE_URL=postgresql://octofleet:your-password@localhost:5432/inventory
INVENTORY_API_KEY=your-secure-api-key-here
JWT_SECRET=your-jwt-secret-min-32-chars
NVD_API_KEY=your-nvd-api-key

# ===================
# Optional
# ===================
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: set a unique initial admin password (minimum 12 characters).
# If omitted, the backend prints a generated one-time password on first start.
# ADMIN_PASSWORD=replace-with-a-long-random-password
