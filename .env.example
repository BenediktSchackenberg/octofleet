# Octofleet – settings for docker compose (copy to .env)
# Generate random values, e.g.: openssl rand -hex 32

# Required – docker compose refuses to start without them
DB_PASSWORD=
JWT_SECRET=
API_KEY=

# Optional: password of the admin user, used only on the very first start
# (12–72 characters, not "admin"). Empty: the backend prints a one-time
# password to its log: docker compose logs backend | grep "One-time admin password"
# ADMIN_PASSWORD=

# Optional: allowed CORS origins (default *), e.g. https://octofleet.example.com
# CORS_ORIGINS=

# Optional: backend URL as seen by the browser (default: same host, port 8080)
# NEXT_PUBLIC_API_URL=

# The NVD API key for vulnerability scans is set in the UI: Settings -> NVD API Key
