# Octofleet Linux Agent Configuration
# Copy to config.env and adjust values

# API endpoint (no trailing slash)
API_URL="http://your-server:8080"

# API authentication key
API_KEY="your-api-key"

# Node identifier (defaults to hostname)
NODE_ID=""

# Inventory push interval in seconds (default: 60 min). Pushes are spread over the interval: the
# first one after the start at a random 50-150 %, then every interval +/- 10 %
PUSH_INTERVAL=3600

# First retry of a failed inventory push in seconds (default: 1 min) - e.g. after a reboot, while the
# server is not reachable yet. Doubles with every further failure up to PUSH_INTERVAL, plus 0-50 %
# random jitter, so a large fleet does not retry in lockstep
PUSH_RETRY_INTERVAL=60

# A failed push is logged as one sentence; the same failure again at most every PUSH_FAIL_LOG_INTERVAL
# seconds ("still failing, n times since ..."). LOG_LEVEL=debug also logs the server's raw answer.
# A rejected inventory is saved root-only in DIAG_DIR (default: diagnostics/ next to agent.sh)
#PUSH_FAIL_LOG_INTERVAL=3600
#LOG_LEVEL=info
#DIAG_DIR=/opt/octofleet-agent/diagnostics

# Job polling interval in seconds (default: 1 min)
JOB_POLL_INTERVAL=60

# Live data push interval in seconds (default: 5 sec)
LIVE_DATA_INTERVAL=5

# Terminal commands and screen sessions: the agent asks about every POLL_IDLE_INTERVAL seconds while
# nothing happens (default: 5 sec), every second while a terminal page for this node is open, and
# SESSION_ACTIVE_GRACE seconds after (default: 1 min). A new session waits up to POLL_IDLE_INTERVAL.
POLL_IDLE_INTERVAL=5
SESSION_ACTIVE_GRACE=60

# Long-poll: one request the server holds until there is work for this node (a job, a terminal
# command, a screen session); the polls above then only run every LONG_POLL_FALLBACK_INTERVAL seconds
# (default: 10 min). Older servers without it: the polls above as before. LONG_POLL=false turns it off
#LONG_POLL=true
#LONG_POLL_SECONDS=55
#LONG_POLL_FALLBACK_INTERVAL=600

# Log rotation: the agent installs /etc/logrotate.d/octofleet-agent for LOG_FILE (weekly, or earlier
# at LOG_ROTATE_MAXSIZE; LOG_ROTATE_COUNT files kept, compressed) and keeps it current. Delete the
# file's first line to keep your own version; LOGROTATE_FILE="" turns it off
#LOG_ROTATE_COUNT=8
#LOG_ROTATE_MAXSIZE=10M
#LOGROTATE_FILE=/etc/logrotate.d/octofleet-agent
