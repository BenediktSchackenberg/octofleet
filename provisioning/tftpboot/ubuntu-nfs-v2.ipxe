#!ipxe
# Octofleet Ubuntu 24.04 NFS Boot - Syntax Variant A
# Args inline mit kernel (OHNE imgargs)

echo
echo =============================================
echo    Octofleet Ubuntu 24.04 NFS Boot
echo    Syntax: kernel URL ARGS
echo =============================================
echo

set nfs-server 192.168.0.5
set nfs-path /mnt/ubuntu-24.04
set pxe-server http://192.168.0.5:9080

echo MAC: ${mac}
echo
echo Downloading kernel + initrd...

# Syntax A: Args direkt bei kernel, initrd separat
kernel ${pxe-server}/ubuntu-live/24.04/casper/vmlinuz boot=casper netboot=nfs nfsroot=${nfs-server}:${nfs-path},tcp,vers=3 ip=dhcp --- || goto failed
initrd ${pxe-server}/ubuntu-live/24.04/casper/initrd || goto failed

echo
echo Booting with NFS root: ${nfs-server}:${nfs-path}
echo
boot || goto failed

:failed
echo
echo !! BOOT FAILED !!
echo
shell
