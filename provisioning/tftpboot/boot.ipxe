#!ipxe

set pxe-server http://192.168.0.5:9080
set api-server http://192.168.0.5:8080
set menu-timeout 15000

echo
echo  ===============================================
echo       ___       _        __ _           _   
echo      / _ \ ___ | |_ ___ / _| | ___  ___| |_ 
echo     | | | / __|| __/ _ \ |_| |/ _ \/ _ \ __|
echo     | |_| \__ \| || (_) |  _| |  __/  __/ |_ 
echo      \___/|___/ \__\___/|_| |_|\___|\___|\__|
echo                                              
echo         Zero-Touch OS Deployment
echo  ===============================================
echo
echo  MAC: ${mac}
echo  IP:  ${ip}
echo

# E19-06: Register this system in the discovery registry
:register
echo  Registering system...
imgfetch --name register ${api-server}/api/v1/discovered-systems/register?mac_address=${mac:hexhyp}&ip_address=${ip}&boot_mode=${platform} || echo  (Registration skipped)
imgfree register ||

:check_config
echo  Checking for provisioning task...
chain ${pxe-server}/boot/${mac:hexhyp}.ipxe && goto boot_done ||

:menu
menu Octofleet PXE Boot
item --gap --  -------- Options --------
item ubuntu    Boot Ubuntu 24.04 Live (NFS)
item winpe     Boot WinPE / Windows Install
item local     Boot from local disk
item shell     iPXE Shell
item reboot    Reboot
choose --timeout ${menu-timeout} --default local target && goto ${target} || goto local

:ubuntu
echo Loading Ubuntu 24.04 via NFS...
set nfs-server 192.168.0.5
kernel nfs://${nfs-server}/mnt/ubuntu-24.04/casper/vmlinuz
initrd nfs://${nfs-server}/mnt/ubuntu-24.04/casper/initrd
imgargs vmlinuz initrd=initrd boot=casper netboot=nfs nfsroot=${nfs-server}:/mnt/ubuntu-24.04 ip=dhcp ---
boot || goto menu

:winpe
echo.
echo !! WinPE boot.wim is 512MB - too large for iPXE !!
echo !! iPXE has ~400MB RAM limit for initrd files  !!
echo.
echo Options:
echo  1. Use USB stick with Windows installer
echo  2. Build mini WinPE with ADK (under 400MB)
echo  3. Try sanboot to iSCSI/NFS target
echo.
echo Press any key to return to menu...
prompt
goto menu

:local
echo Booting from local disk...
exit 0

:shell
shell
goto menu

:reboot
reboot

:boot_done
echo Done.
