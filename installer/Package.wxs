<?xml version="1.0" encoding="UTF-8"?>
<!--
  Octofleet Agent MSI (WiX v5). Properties and deployment: installer/README.md.

  - Same folder and service as Install-OctofleetAgent.ps1 (C:\Program Files\Octofleet,
    service OctofleetNodeAgent), so the MSI installs over a script install and keeps its config.
  - The config in C:\ProgramData\Octofleet is not part of the package: upgrade, repair and
    uninstall leave it alone; the custom action only writes the properties that are passed.
  - The registry key SOFTWARE\Octofleet\Agent (InstallSource=msi) tells the agent that the MSI
    owns its files: self-update is off, a new version comes as a new MSI.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Octofleet Agent"
           Manufacturer="Octofleet"
           Version="$(var.Version)"
           UpgradeCode="E8F9D4A2-7B3C-4E5F-9A1D-2C6B8F0E3D7A"
           Scope="perMachine">

    <SummaryInformation Description="Octofleet Agent $(var.Version)" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- One entry in Programs and Features: the old version is removed before the new one is
         installed; a rebuild of the same version replaces the installed one; downgrades fail (1603) -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Icon Id="OctofleetIcon" SourceFile="..\src\OctofleetAgent.Service\Assets\octofleet.ico" />
    <Property Id="ARPPRODUCTICON" Value="OctofleetIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/BenediktSchackenberg/octofleet" />

    <!-- Public properties. Secure: kept in managed installs (GPO, Intune, ConfigMgr).
         API_KEY is hidden: msiexec /l*v does not log it. -->
    <Property Id="SERVER_URL" Secure="yes" />
    <Property Id="API_KEY" Secure="yes" Hidden="yes" />
    <Property Id="DISPLAY_NAME" Secure="yes" />
    <Property Id="PUSH_INTERVAL" Secure="yes" />
    <Property Id="SCREEN_HELPER" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Octofleet" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CONFIGDIR" Name="Octofleet" />
    </StandardDirectory>

    <Feature Id="Agent" Title="Octofleet Agent" Description="The agent service (OctofleetNodeAgent)."
             Level="1" AllowAbsent="no" Display="expand">
      <ComponentGroupRef Id="AgentComponents" />

      <!-- Off by default; SCREEN_HELPER=1 or ADDLOCAL=ScreenHelper installs it. An upgrade keeps
           the choice of the installed version. -->
      <Feature Id="ScreenHelper" Title="Screen helper"
               Description="Remote screen view and control from the console. The agent starts it in the user's session when a screen session is opened."
               Level="1000">
        <Level Value="1" Condition="SCREEN_HELPER = &quot;1&quot;" />
        <ComponentRef Id="ScreenHelperExe" />
      </Feature>
    </Feature>

    <CustomActionRef Id="WriteConfigFile" />

  </Package>

  <Fragment>
    <ComponentGroup Id="AgentComponents" Directory="INSTALLFOLDER">

      <Component Id="ServiceExe">
        <File Id="ServiceExe" Source="$(var.AgentFilesDir)OctofleetAgent.Service.exe" KeyPath="yes" />

        <ServiceInstall Id="AgentService"
                        Name="OctofleetNodeAgent"
                        DisplayName="Octofleet Agent"
                        Description="Octofleet endpoint management agent"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <!-- Like the install script's sc.exe failure: restart the service after a failure (three times),
               reset the count after a day. util:ServiceConfig has one delay for all restarts. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="10"
                              ResetPeriodInDays="1" />
        </ServiceInstall>

        <!-- Remove on install too: takes over the service of a script install (same name) -->
        <ServiceControl Id="AgentService" Name="OctofleetNodeAgent" Start="install" Stop="both" Remove="both" Wait="yes" />
        <!-- Service name of older script installs -->
        <ServiceControl Id="OlderAgentService" Name="Octofleet Agent" Stop="install" Remove="install" Wait="yes" />

        <!-- As the install script and the self-update set it: .NET extracts its native files there -->
        <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\OctofleetNodeAgent" Name="Environment" Type="multiString">
          <MultiStringValue Value="DOTNET_BUNDLE_EXTRACT_BASE_DIR=[CONFIGDIR]extract" />
        </RegistryValue>

        <!-- Files a script install left in the folder (symbols, install script) go on uninstall -->
        <RemoveFile Id="LeftoverFiles" Name="*" On="uninstall" />
      </Component>

      <Component Id="InstallSource">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Octofleet\Agent">
          <RegistryValue Name="InstallSource" Type="string" Value="msi" KeyPath="yes" />
          <RegistryValue Name="ProductCode" Type="string" Value="[ProductCode]" />
          <RegistryValue Name="Version" Type="string" Value="[ProductVersion]" />
        </RegistryKey>
      </Component>

    </ComponentGroup>

    <Component Id="ScreenHelperExe" Directory="INSTALLFOLDER">
      <File Id="ScreenHelperExe" Source="$(var.AgentFilesDir)OctofleetScreenHelper.exe" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Binary Id="CustomActionsDll" SourceFile="$(var.CustomActions.TargetDir)CustomActions.CA.dll" />

    <!-- HideTarget: the CustomActionData (with API_KEY) is not logged -->
    <CustomAction Id="WriteConfigFile"
                  BinaryRef="CustomActionsDll"
                  DllEntry="WriteConfigFile"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check"
                  HideTarget="yes" />

    <SetProperty Id="WriteConfigFile"
                 Value="SERVER_URL=[SERVER_URL];API_KEY=[API_KEY];DISPLAY_NAME=[DISPLAY_NAME];PUSH_INTERVAL=[PUSH_INTERVAL];CONFIGDIR=[CONFIGDIR]"
                 Before="WriteConfigFile"
                 Sequence="execute"
                 Condition="NOT REMOVE~=&quot;ALL&quot;" />

    <InstallExecuteSequence>
      <Custom Action="WriteConfigFile" Before="StartServices" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Fragment>

</Wix>
